    <string name="pref_suppress_title">Remove app prompts and the 18+ wall</string>
    <string name="pref_suppress_summary">Hides Reddit\'s "open in app" takeover
        and the age wall it uses to push the app, and unblurs the content behind
        them.</string>

    <string name="pref_bundles_title">Block the prompt code from loading</string>
    <string name="pref_bundles_summary">Refuses Reddit\'s app-promotion scripts
        at the network, so the overlays are never built rather than removed
        afterwards. Turn off if part of the site stops working.</string>

    <string name="pref_ua_title">Site version</string>

    <string name="pref_start_page_title">Start page</string>

    <string name="pref_block_mode_title">Blocking</string>

    <string name="pref_ephemeral_title">Anonymous session</string>
    <string name="pref_ephemeral_summary">Clear cookies, storage and cache when
        the app closes. Turning this off is what lets a sign-in persist.</string>

    <string name="pref_age_gate_title">Set Reddit\'s adult-content cookie</string>
    <string name="pref_age_gate_summary">Best-effort: sets Reddit\'s own
        preference cookies. Quarantined communities are a different mechanism and
        still need an account.</string>

    <string name="pref_external_title">Open off-site links in a browser</string>
    <string name="pref_external_summary">Off keeps every non-Reddit link from
        leaving the app at all.</string>

    <string name="pref_private_tab_title">Open external links privately</string>
    <string name="pref_private_tab_summary">Firefox and its forks honour a
        private-tab request from another app. Chromium browsers, including
        Vanadium, refuse it — the app will say so rather than open a normal tab
        and call it private.</string>

