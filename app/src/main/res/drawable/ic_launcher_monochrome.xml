<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome variant for Android 13+ themed icons; the system supplies the
  tint, so this must be a single colour with no background of its own.
 

  All art sits inside the 66dp safe circle of the 108dp adaptive canvas:
  the furthest point is (74,36), 26.9dp from centre, plus half the 6dp
  stroke = 29.9dp against a 33dp radius.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:strokeColor="#000000"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M34,36 H74" />
    <path
        android:strokeColor="#000000"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M40,44 V54 H74" />
    <path
        android:strokeColor="#000000"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M56,60 V70 H74" />
</vector>
